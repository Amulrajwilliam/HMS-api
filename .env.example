# Copy to `.env` in this folder (`apps/api/.env`). Never commit real secrets.

# ── PostgreSQL (required for Phase 2 + rest of HMS) ─────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=hms_db

# Dev: TypeORM can sync schema when synchronize is on (default in non-production).
# Recommended for shared/prod DB: turn off sync and use migrations only.
# DB_SYNCHRONIZE=false
# DB_MIGRATIONS_RUN=true

# ── App ────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
# Bind address: use 0.0.0.0 (default) so phones / Expo Go on the same Wi‑Fi can reach the API.
# For a locked-down local bind only: LISTEN_HOST=127.0.0.1
# LISTEN_HOST=0.0.0.0
# Used by API CORS — must match the web app origin (Vite default: 3001).
WEB_URL=http://localhost:3001
# Production: comma-separated allowed browser origins. Dev mode allows all origins (CORS origin: true).
# CORS_EXTRA_ORIGINS=https://app.example.com,https://staging.example.com

# ── JWT ────────────────────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars_random
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_min_32_chars_random
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP / email / SMS (Phase 1) ────────────────────────────────────
OTP_LOG_TO_CONSOLE=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com

# ── Phase 2 — Reports storage ──────────────────────────────────────
# Omit AWS_* to use local disk: `apps/api/uploads/reports` (created at runtime).
# For DICOM/PDF presigned URLs in the browser, configure S3 AND bucket CORS (see Docs).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=your-hms-reports-bucket
# Optional override for local path:
# REPORTS_LOCAL_DIR=

# ── Phase 3 — External integration adapters (stubs by default) ─────
# INTEGRATION_LAB_PROVIDER=
# INTEGRATION_LAB_BASE_URL=
# INTEGRATION_INSURANCE_PROVIDER=
# INTEGRATION_INSURANCE_BASE_URL=
# INTEGRATION_PACS_PROVIDER=
# INTEGRATION_PACS_BASE_URL=
# Optional per-provider auth/signing
# INTEGRATION_LAB_API_KEY=
# INTEGRATION_LAB_HMAC_SECRET=
# INTEGRATION_INSURANCE_API_KEY=
# INTEGRATION_INSURANCE_HMAC_SECRET=
# INTEGRATION_PACS_API_KEY=
# INTEGRATION_PACS_HMAC_SECRET=
# Adapter resilience controls
# INTEGRATION_RETRY_COUNT=2
# INTEGRATION_TIMEOUT_MS=4000
# INTEGRATION_CB_THRESHOLD=3
# INTEGRATION_CB_COOLDOWN_MS=30000

# ── Phase 4 — Notifications + Mobile sync ───────────────────────────
# FCM (Firebase Admin) for push notifications
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
# Optional SMS provider webhook endpoint
# SMS_PROVIDER_URL=
# SMS_PROVIDER_API_KEY=

# ── Phase 5 — BullMQ (analytics export jobs; requires Redis) ───────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
